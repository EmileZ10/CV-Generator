{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-branch-creation.py\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking for git branch creation"
          }
        ]
      }
    ]
  }
}
